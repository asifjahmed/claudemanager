{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claudemanager offers feed",
  "type": "object",
  "required": ["version", "offers"],
  "properties": {
    "version": { "const": 1 },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "deadline"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
          "kind": { "enum": ["free-reset"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "startsAt": { "type": "string", "format": "date-time" },
          "deadline": { "type": "string", "format": "date-time" },
          "usesPerAccount": { "type": "integer", "minimum": 1, "default": 1 },
          "resets": { "type": "array", "items": { "enum": ["session", "weekly", "model"] } }
        }
      }
    }
  }
}
